{
  "name": "ie-calculator",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "build:online": "vue-tsc -b && vite build --mode online-single",
    "build:single": "vue-tsc -b && vite build --mode offline-single",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "vite": "latest",
    "vue": "latest",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite-plugin-singlefile": "latest",
    "vue-tsc": "latest"
  }
}
